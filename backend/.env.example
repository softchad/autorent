# JWT tokenų pasirašymui - privalomas, min. 32 simboliai.
SECRET_KEY=your-random-secret-here

# Privalomas - serveris IŠKART atsisako startuoti, jei jo trūksta (žr. db/session.py). Skaitomas TIESIAI per os.getenv, ne per kitus kintamuosius valdantį utils/config.py.
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/your_db_name

# Naudotojo sąsajos adresas - CORS leidžiamas šaltinis ir OAuth redirect'ų bazė. Neprivalomas - be jo numatytoji reikšmė lieka ta pati, kaip čia parašyta (žr. utils/config.py).
FRONTEND_URL=http://localhost:3000

# Google OAuth (gaunama Google Cloud Console)
GOOGLE_CLIENT_ID=get-this-from-google-console
GOOGLE_CLIENT_SECRET=get-this-from-google-console
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/google/callback

# GitHub OAuth - neprivalomas, jei nenustatytas GitHub prisijungimas tiesiog neaktyvus.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8000/api/v1/github/callback

# OAuth sesijos cookie pasirašymui - privalomas, min. 32 simboliai.
SESSION_SECRET_KEY=another-random-secret

# Adresų paieška be API rakto; paprastai keisti nereikia.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search

