# AutoRent API adresas (be /api/v1 galo).
# Android emuliatoriui naudojamas 10.0.2.2.
# Telefonui per Expo Go reikia kompiuterio vietinio IP adreso.
# Production versijoje leidžiamas tik https:// adresas.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Neprivaloma: maršrutų paslauga (OSRM formato API, tik https://), pvz. savo OSRM serveris.
# Nenurodžius maršrutas žemėlapyje nebraižomas – programėlė siūlo atidaryti išorinę navigaciją.
# Dėmesio: nurodžius, kliento ir padalinio koordinatės siunčiamos šiai paslaugai, kai klientas paspaudžia „Rodyti maršrutą“.
# EXPO_PUBLIC_ROUTING_URL=https://routing.example.com

# Neprivaloma: kitos žemėlapio plytelės (https šablonas su {z}/{x}/{y}); numatytosios – OpenStreetMap su tamsiu CSS filtru.
# Pasirinktinės plytelės naudojamos tik kartu su netuščia autoryste (paprastas tekstas); kitaip rodomos OpenStreetMap plytelės.
# EXPO_PUBLIC_MAP_TILES_URL=https://tiles.example.com/dark/{z}/{x}/{y}.png
# EXPO_PUBLIC_MAP_TILES_ATTRIBUTION=© Plytelių tiekėjas
