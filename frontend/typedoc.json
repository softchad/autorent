{
  "entryPoints": [
    "src/app/components",
    "src/app/(public)",
    "src/app/(staff)",
    "src/app/providers",
    "src/hooks",
    "src/store",
    "src/utils",
    "src/middleware.ts"
  ],
  "out": "docs",
  "tsconfig": "tsconfig.json",
  "entryPointStrategy": "expand",
  "skipErrorChecking": true,
  "name": "AutoRent Frontend",
  "readme": "../README.md",
  "excludeTags": ["@file"]
}
